{
  "name": "cursorping",
  "displayName": "Pingy",
  "description": "Pingy — Get notified when your AI coding agent needs you. Your AI coding agent's little notification buddy.",
  "version": "0.3.4",
  "publisher": "OwaisRafiq",
  "author": {
    "name": "Owais Rafiq",
    "url": "https://github.com/owaisrafiq05"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "agent",
    "ntfy",
    "notifications",
    "hooks",
    "pingy"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cursorping.setup",
    "onCommand:cursorping.sendTest",
    "onCommand:cursorping.showPairingQr"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorping.setup",
        "title": "Pingy: Run Setup (once for all projects)"
      },
      {
        "command": "cursorping.sendTest",
        "title": "Pingy: Send Test Notification"
      },
      {
        "command": "cursorping.showPairingQr",
        "title": "Pingy: Show Pairing QR Code"
      }
    ],
    "configuration": {
      "title": "Pingy",
      "properties": {
        "cursorping.serverUrl": {
          "type": "string",
          "default": "https://ntfy.sh",
          "description": "ntfy server base URL (use your self-hosted instance if preferred)"
        },
        "cursorping.pendingTimeoutMs": {
          "type": "number",
          "default": 2000,
          "description": "Milliseconds an open tool/shell/MCP gate may stay unresolved before it is treated as the Agent waiting for your permission (keep small for near-immediate Run/Skip alerts)"
        },
        "cursorping.pendingMaxAgeMs": {
          "type": "number",
          "default": 1800000,
          "description": "Milliseconds after which an unresolved gate is treated as abandoned (Cursor restarted, agent crashed) instead of waiting"
        },
        "cursorping.watcherIntervalMs": {
          "type": "number",
          "default": 1000,
          "description": "How often the extension polls pending-approval state"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"test/**/*.test.js\"",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.3.3"
  },
  "homepage": "https://github.com/owaisrafiq05",
  "repository": {
    "type": "git",
    "url": "https://github.com/owaisrafiq05"
  },
  "bugs": {
    "url": "https://github.com/owaisrafiq05"
  },
  "icon": "media/icon.png"
}
